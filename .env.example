# Copy to .env (never commit it) and fill in. Read by compose.yaml.

# --- Required ---------------------------------------------------------------
# Signs the login tokens. Generate one with: openssl rand -base64 48
JWT_SECRET=

# --- Published port ---------------------------------------------------------
# nginx listens here. 127.0.0.1 keeps it local (put a TLS terminator in front);
# use 0.0.0.0 to expose it on every interface.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# --- Association printed on the Cerfa 11580 tax receipts ----------------------
# Receipts can't be issued (503) until NAME, ADDRESS, POSTAL_CODE, CITY and
# OBJECT are set.
ASSOCIATION_NAME=MAISON DES JEUNES DE VAUBECOURT HAND BALL
ASSOCIATION_ADDRESS=2 rue du Blé Battu
ASSOCIATION_POSTAL_CODE=55250
ASSOCIATION_CITY=Rembercourt-Sommaisne
ASSOCIATION_RNA=W551000642
ASSOCIATION_SIREN=390451110
# Objet de l'association, from the statuts (still missing, see issue #20).
ASSOCIATION_OBJECT=
# ASSOCIATION_STATUS defaults to "Œuvre ou organisme d'intérêt général".

# --- Optional ---------------------------------------------------------------
# REGISTRATION_NUMBER_PATTERN=^5655006[0-9]{6}$
